{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: Native MSYS2 Clang Build",
            "command": "C:\\msys64\\ucrt64\\bin\\clang++.exe",
            "args": [
                "-std=c++26",
                "-g",
                "${workspaceFolder}/src/core/*.cpp",
                "${workspaceFolder}/src/systems/*.cpp",
                "${workspaceFolder}/src/rendering/*.cpp",
                "${workspaceFolder}/src/glad.c",
                "-I${workspaceFolder}/include",
                "-lglfw3",
                "-lassimp",
                "-lopengl32",
                "-lgdi32",
                "-o",
                "${workspaceFolder}/build/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "compiler: C:\\msys64\\ucrt64\\bin\\clang++.exe"
        }
    ]
}